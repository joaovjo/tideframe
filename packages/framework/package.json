{
  "name": "tideframe",
  "version": "0.1.0",
  "type": "module",
  "description": "Backend framework TypeScript 7.x, Bun-first, batteries-included, zero runtime dependencies, frontend-agnostic.",
  "main": "./src/core/index.ts",
  "exports": {
    "./core": "./src/core/index.ts",
    "./errors": "./src/errors/index.ts",
    "./log": "./src/log/index.ts",
    "./config": "./src/config/index.ts",
    "./validate": "./src/validate/index.ts",
    "./di": "./src/di/index.ts",
    "./http": "./src/http/index.ts",
    "./events": "./src/events/index.ts",
    "./ws": "./src/ws/index.ts",
    "./cache": "./src/cache/index.ts",
    "./queue": "./src/queue/index.ts",
    "./storage": "./src/storage/index.ts",
    "./orm": "./src/orm/index.ts",
    "./mailer": "./src/mailer/index.ts",
    "./auth": "./src/auth/index.ts",
    "./cli": "./src/cli/index.ts",
    "./test": "./src/test/index.ts"
  },
  "imports": {
    "#core": "./src/core/index.ts",
    "#core/*": "./src/core/*",
    "#errors": "./src/errors/index.ts",
    "#errors/*": "./src/errors/*",
    "#log": "./src/log/index.ts",
    "#log/*": "./src/log/*",
    "#config": "./src/config/index.ts",
    "#config/*": "./src/config/*",
    "#validate": "./src/validate/index.ts",
    "#validate/*": "./src/validate/*",
    "#di": "./src/di/index.ts",
    "#di/*": "./src/di/*",
    "#http": "./src/http/index.ts",
    "#http/*": "./src/http/*",
    "#events": "./src/events/index.ts",
    "#events/*": "./src/events/*",
    "#ws": "./src/ws/index.ts",
    "#ws/*": "./src/ws/*",
    "#cache": "./src/cache/index.ts",
    "#cache/*": "./src/cache/*",
    "#queue": "./src/queue/index.ts",
    "#queue/*": "./src/queue/*",
    "#storage": "./src/storage/index.ts",
    "#storage/*": "./src/storage/*",
    "#orm": "./src/orm/index.ts",
    "#orm/*": "./src/orm/*",
    "#mailer": "./src/mailer/index.ts",
    "#mailer/*": "./src/mailer/*",
    "#auth": "./src/auth/index.ts",
    "#auth/*": "./src/auth/*",
    "#cli": "./src/cli/index.ts",
    "#cli/*": "./src/cli/*",
    "#test": "./src/test/index.ts",
    "#test/*": "./src/test/*"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
